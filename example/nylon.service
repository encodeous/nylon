# Sample unit; install.sh --service installs an equivalent one.
[Unit]
Description=nylon mesh network
Documentation=https://nylon.jq.ax
After=network-online.target
Wants=network-online.target

[Service]
ExecStart=/usr/local/bin/nylon run -c /etc/nylon/central.yaml -n /etc/nylon/node.yaml
WorkingDirectory=/etc/nylon
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
